# Auth.js - generer med: openssl rand -base64 32
AUTH_SECRET=

# ID-porten (test-miljø: https://selvbetjening.test.digdir.no)
# Klient for flyt 3 (sluttbrukersystem) — må ha alle enduser-scopes for Altinn
IDPORTEN_CLIENT_ID=
# Privatnøkkel for private_key_jwt (deles av begge ID-porten-klienter)
# Generer med: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt | openssl rsa -pubout
# Last opp public key (PEM) i selvbetjening og noter kid som tildeles
IDPORTEN_PRIVATE_KEY_JWK=
# IDPORTEN_CLIENT_SECRET=  # Kun nødvendig hvis IDPORTEN_PRIVATE_KEY_JWK ikke er satt

# ID-porten tjenesteeier-klient (flyt 2) — separat klient med kun openid profile-scope
# Registrer ny klient i selvbetjening med samme public key som over
IDPORTEN_TJENESTEEIER_CLIENT_ID=
# kid som samarbeidsportalen tildelte ved nøkkelopplasting for tjenesteeier-klienten
# (kan avvike fra kid i IDPORTEN_PRIVATE_KEY_JWK hvis portalen tildeler ulike kid-er)
IDPORTEN_TJENESTEEIER_KID=

# App URL (lokalt: http://localhost:3000)
AUTH_URL=http://localhost:3000

# Maskinporten (test-miljø)
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_PRIVATE_KEY_JWK=

# Altinn platform.tt02.altinn.no — subscription key fra Altinn API Portal
ALTINN_SUBSCRIPTION_KEY=

# Integrasjonstesting — fødselsnummer for TEST_PID (kun for npm run test:integration)
# TEST_PID=

# E2E-testing med Playwright (npm run test:e2e)
# STANDARD_BRUKER brukes som testbruker. Fallback til TEST_PID hvis ikke satt.
# STANDARD_BRUKER=
