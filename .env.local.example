# Auth.js - generer med: openssl rand -base64 32
AUTH_SECRET=

# ID-porten (test-miljø: https://selvbetjening.test.digdir.no)
IDPORTEN_CLIENT_ID=
# Privatnøkkel for private_key_jwt (anbefalt — client_secret er fallback hvis denne mangler)
IDPORTEN_PRIVATE_KEY_JWK=
# IDPORTEN_CLIENT_SECRET=  # Kun nødvendig hvis IDPORTEN_PRIVATE_KEY_JWK ikke er satt

# App URL (lokalt: http://localhost:3000)
AUTH_URL=http://localhost:3000

# Maskinporten (test-miljø)
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_PRIVATE_KEY_JWK=

# Integrasjonstesting — fødselsnummer for TEST_PID (kun for npm run test:integration)
# TEST_PID=

# E2E-testing med Playwright (npm run test:e2e)
# STANDARD_BRUKER brukes som testbruker. Fallback til TEST_PID hvis ikke satt.
# STANDARD_BRUKER=
